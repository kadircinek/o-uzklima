# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_...) — eski projelerde "anon" anahtarı da olur
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# "Secret key" (sb_secret_...) — eski projelerde "service_role" anahtarı. Yalnızca sunucuda kullanılır.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Claude API (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=sk-ant-...
# İsteğe bağlı; varsayılan claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Web Push (npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Push servisleri için iletişim adresi
VAPID_SUBJECT=mailto:siz@ornek.com

# --- Hatırlatma motoru ---
# Uzun rastgele bir değer (ör. openssl rand -hex 32). supabase/cron.sql'deki değerle aynı olmalı.
CRON_SECRET=
